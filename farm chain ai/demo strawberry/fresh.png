    <script defer>
      setTimeout(() => {
        const reference = document.querySelector('.our_categories_product_quantity');
        const child = document.querySelector('.BLOY-point-calculator');

        console.log('Reference:', reference);
        console.log('Child:', child);

        if (reference && child) {
          reference.after(child);
        } else {
          console.warn('Không tìm thấy reference hoặc child!');
        }
      }, 3000);
    </script>
    <script defer>
      setTimeout(() => {
        // Kiểm tra nếu đang ở giao diện mobile (<= 768px)
        if (window.innerWidth <= 768) {
          const reference = document.querySelector('.product_details_price');
          const child = document.querySelector('.BLOY-point-calculator');

          if (reference && child) {
            reference.after(child);
          } else {
            console.warn('Không tìm thấy phần tử reference hoặc child');
          }
        }
      }, 3000); // chạy sau 3 giây
    </script>

