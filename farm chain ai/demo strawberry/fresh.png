<script>
  /**
   * Mobile Sidebar: Open / Close
   * Toggles the .open class on .side-bar when the hamburger
   * or close button is clicked.
   */
  document.addEventListener('DOMContentLoaded', function () {
    const sidebar = document.querySelector('.side-bar');
    const openBtn = document.querySelector('.menu-btn');
    const closeBtn = document.querySelector('.close-btn');

    if (openBtn) openBtn.addEventListener('click', () => sidebar.classList.add('active'));
    if (closeBtn) closeBtn.addEventListener('click', () => sidebar.classList.remove('active'));

    /**
     * Mobile Search: Popup Toggle
     * Clicking the search icon adds/removes .toggled on #search-menu,
     * which slides it down from off-screen (handled by existing CSS).
     */
    const searchTrigger = document.querySelector('#popup-search-trigger');
    const searchMenu = document.querySelector('#search-menu');

    if (searchTrigger && searchMenu) {
      searchTrigger.addEventListener('click', (e) => {
         e.stopPropagation();
        searchMenu.classList.toggle('toggled');
        // Focus the input when opened for better UX
        if (searchMenu.classList.contains('toggled')) {
          searchMenu.querySelector('input')?.focus();
        }
      });
    }

    /**
     * Mobile Navigation: Custom Dropdown Toggle
     *
     * Overrides Bootstrap's default dropdown behaviour for .mob-dropdown
     * items. Closes sibling menus before opening the clicked one, and uses
     * stopPropagation() to prevent Bootstrap from immediately collapsing it.
     */
    document.querySelectorAll('.mob-dropdown .dropdown-toggle').forEach((toggle) => {
      toggle.removeAttribute('data-toggle');

      toggle.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const submenu = this.nextElementSibling;
        const parentMenu = this.closest('ul');

        // Close all sibling submenus at the same level
        parentMenu.querySelectorAll(':scope > li > .dropdown-menu').forEach((menu) => {
          if (menu !== submenu) menu.style.display = 'none';
        });

        // Toggle the clicked submenu open/closed
        if (submenu && submenu.classList.contains('dropdown-menu')) {
          submenu.style.display = submenu.style.display === 'block' ? 'none' : 'block';
        }
      });
    });
  });
</script>
