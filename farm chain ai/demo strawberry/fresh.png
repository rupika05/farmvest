" class=\"button hollow circle add_btn_border quick_view view_plus\" data-cart=\"\" data-quantity=\"plus\" del-price=\"\" data-field=\"quantity\" data-product-id=\"\"\u003e\n                          \u003ci class=\"fa fa-plus\" aria-hidden=\"true\"\u003e\u003c\/i\u003e\n                        \u003c\/button\u003e\n                      \u003c\/div\u003e\n                    \u003c\/div\u003e\n                    \u003cspan class=\"quickview_product_weight\" style=\"white-space: nowrap;\"\u003e\u003c\/span\u003e\n                  \u003c\/div\u003e\n                \u003c\/div\u003e\n\n                \n              \u003c\/div\u003e\n\n            \u003c\/div\u003e\n            \u003cdiv class=\"quick_view_product_details_about product_border_bottom\"\u003e\n              \u003ca class=\"view-product\" href=\"\"\u003e\n                \u003cbutton type=\"button\" class=\"btn btn-block view-button\"\u003eView Full Product Details\u003c\/button\u003e\n              \u003c\/a\u003e\n            \u003c\/div\u003e\u003c\/div\u003e\n        \u003c\/div\u003e\n      \u003c\/div\u003e\n    \u003c\/div\u003e\n  \u003c\/div\u003e\n\u003c\/div\u003e\n\u003c!-- Quick view Modal End --\u003e\n      ";
