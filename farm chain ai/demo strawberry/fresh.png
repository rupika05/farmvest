    function _dbInitWidgetReact() {
      if (typeof _dbApi().initWidgetReactRender === 'function') {
        _dbApi().initWidgetReactRender();
      }
    }
    if (typeof _dbApi().initWidgetReactRender === 'function') {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', _dbInitWidgetReact, { once: true });
