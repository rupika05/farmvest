<script>
  (function() {
    // Canonical namespace — all Dollarlabs storefront globals live under
    // window.dollarlabs. The deferred bundle adds functions/classes later;
    // merge into the namespace, never replace it.
    window.dollarlabs = window.dollarlabs || {};
    window.dollarlabs.dollarback = window.dollarlabs.dollarback || {};
    const dl = window.dollarlabs;
    const db = dl.dollarback;

    // Thin wrapper over the event the widget already listens for, so it works
    // whether or not the deferred bundle has loaded.
    db.openWidget = function (options) {
      window.dispatchEvent(new CustomEvent('dollarback:open-widget', { detail: options || {} }));
